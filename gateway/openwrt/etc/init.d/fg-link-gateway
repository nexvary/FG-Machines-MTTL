#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

start_service() {
	config_load fg-link-gateway
	config_get_bool enabled gateway enabled 0
	[ "$enabled" -eq 1 ] || return 0

	config_get api_bind gateway api_bind '127.0.0.1:18086'
	config_get controller_bind gateway controller_bind '0.0.0.0:10086'
	config_get token gateway token ''

	[ "${#token}" -ge 24 ] || {
		logger -t fg-link-gateway "token is missing or too short"
		return 1
	}

	procd_open_instance
	procd_set_param command /usr/bin/fg-link-gateway -api-bind "$api_bind" -controller-bind "$controller_bind"
	procd_set_param env FG_GATEWAY_TOKEN="$token"
	procd_set_param respawn 5 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
