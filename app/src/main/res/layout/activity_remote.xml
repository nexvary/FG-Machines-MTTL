<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/remoteRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/remoteBackButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="@string/remote_back"
                android:textColor="@color/fg_text"
                app:cornerRadius="14dp"
                app:strokeColor="@color/fg_metal_silver" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/remote_title"
                android:textAlignment="viewStart"
                android:textColor="@color/fg_neon_cyan"
                android:textSize="24sp"
                android:textStyle="bold" />
            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/remote_title"
                android:src="@drawable/ic_remote"
                app:tint="@color/fg_neon_cyan" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/remote_subtitle"
            android:textAlignment="viewStart"
            android:textColor="@color/fg_text_secondary"
            android:textSize="13sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="@color/fg_surface"
            app:cardCornerRadius="18dp"
            app:strokeColor="@color/fg_metal_silver"
            app:strokeWidth="1dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_status_pill"
                    android:paddingStart="10dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="6dp"
                    android:text="@string/remote_ir_badge"
                    android:textColor="@color/fg_neon_lime"
                    android:textSize="10sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/remoteIrStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textAlignment="viewStart"
                    android:textColor="@color/fg_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/remote_scope_title"
            android:textAlignment="viewStart"
            android:textColor="@color/fg_neon_violet"
            android:textSize="18sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/remote_scope_note"
            android:textAlignment="viewStart"
            android:textColor="@color/fg_text_secondary"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/remoteAcButton"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="14dp"
            android:text="@string/remote_ac_category"
            android:textAllCaps="false"
            android:textColor="@color/fg_neon_cyan"
            android:textSize="17sp"
            android:textStyle="bold"
            app:backgroundTint="@color/fg_surface_2"
            app:cornerRadius="18dp"
            app:icon="@drawable/ic_remote"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            app:iconSize="28dp"
            app:iconTint="@color/fg_neon_cyan"
            app:strokeColor="@color/fg_metal_silver"
            app:strokeWidth="2dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="8dp"
            android:text="@string/remote_ac_note"
            android:textAlignment="viewStart"
            android:textColor="@color/fg_text_secondary"
            android:textSize="11sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/remoteFanButton"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="14dp"
            android:text="@string/remote_fan_category"
            android:textAllCaps="false"
            android:textColor="@color/fg_neon_magenta"
            android:textSize="17sp"
            android:textStyle="bold"
            app:backgroundTint="@color/fg_surface_2"
            app:cornerRadius="18dp"
            app:icon="@drawable/ic_remote"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            app:iconSize="28dp"
            app:iconTint="@color/fg_neon_magenta"
            app:strokeColor="@color/fg_metal_silver"
            app:strokeWidth="2dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="8dp"
            android:text="@string/remote_fan_note"
            android:textAlignment="viewStart"
            android:textColor="@color/fg_text_secondary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/remoteCategoryStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_status_pill"
            android:padding="12dp"
            android:text="@string/remote_profile_status"
            android:textAlignment="viewStart"
            android:textColor="@color/fg_text"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
