<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fg_black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="16dp"
        android:paddingEnd="18dp"
        android:paddingBottom="28dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/fg_black_soft"
            app:cardCornerRadius="22dp"
            app:strokeColor="@color/fg_blue"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/ic_fg_logo" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name"
                        android:textAlignment="viewStart"
                        android:textColor="@color/fg_text"
                        android:textSize="25sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/app_subtitle"
                        android:textAlignment="viewStart"
                        android:textColor="@color/fg_blue_bright"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/brand_tagline"
                        android:textAlignment="viewStart"
                        android:textColor="@color/fg_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/brand_badge"
                android:textAlignment="viewStart"
                android:textColor="@color/fg_green"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/language"
                android:textColor="@color/fg_silver"
                android:textSize="12sp" />

            <Spinner
                android:id="@+id/languageSpinner"
                android:layout_width="128dp"
                android:layout_height="44dp"
                android:backgroundTint="@color/fg_blue"
                android:popupBackground="@color/fg_surface_2" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="@color/fg_surface"
            app:cardCornerRadius="18dp"
            app:strokeColor="@color/fg_green_dark"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/research_mode"
                    android:textAlignment="viewStart"
                    android:textColor="@color/fg_green"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/research_note"
                    android:textAlignment="viewStart"
                    android:textColor="@color/fg_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="@color/fg_surface"
            app:cardCornerRadius="20dp"
            app:strokeColor="@color/fg_green"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/setup_wizard"
                    android:textAlignment="viewStart"
                    android:textColor="@color/fg_text"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/setup_wizard_note"
                    android:textAlignment="viewStart"
                    android:textColor="@color/fg_text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/mobile_hotspot_mode"
                    android:textAlignment="viewStart"
                    android:textColor="@color/fg_blue_bright"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/mobile_hotspot_note"
                    android:textAlignment="viewStart"
                    android:textColor="@color/fg_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/hotspotStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/hotspot_runtime_note"
                    android:textAlignment="viewStart"
                    android:textColor="@color/fg_green"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/openHotspotButton"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:text="@string/open_hotspot_settings"
                        android:textColor="@color/fg_text"
                        app:backgroundTint="@color/fg_blue"
                        app:cornerRadius="14dp" />

                    <Space
                        android:layout_width="8dp"
                        android:layout_height="1dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/refreshHotspotButton"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:text="@string/refresh_hotspot"
                        android:textColor="@color/fg_green"
                        app:cornerRadius="14dp"
                        app:strokeColor="@color/fg_green" />
                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:hint="@string/setup_ssid_hint"
                    app:boxStrokeColor="@color/fg_blue"
                    app:hintTextColor="@color/fg_text_secondary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/setupSsidInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:singleLine="true"
                        android:textColor="@color/fg_text"
                        android:textDirection="ltr" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="@string/target_wifi_ssid_hint"
                    app:boxStrokeColor="@color/fg_green"
                    app:hintTextColor="@color/fg_text_secondary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/targetWifiSsidInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:singleLine="true"
                        android:textColor="@color/fg_text" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="@string/target_wifi_password_hint"
                    app:boxStrokeColor="@color/fg_green"
                    app:endIconMode="password_toggle"
                    app:hintTextColor="@color/fg_text_secondary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/targetWifiPasswordInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:singleLine="true"
                        android:textColor="@color/fg_text" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="@string/controller_ip_hint"
                    app:boxStrokeColor="@color/fg_silver"
                    app:hintTextColor="@color/fg_text_secondary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/controllerIpInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:singleLine="true"
                        android:textColor="@color/fg_text"
                        android:textDirection="ltr" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/provisionButton"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="14dp"
                    android:text="@string/provision_device"
                    android:textColor="@color/fg_black"
                    app:backgroundTint="@color/fg_green"
                    app:cornerRadius="15dp" />

                <TextView
                    android:id="@+id/provisionStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/hotspot_runtime_note"
                    android:textAlignment="viewStart"
                    android:textColor="@color/fg_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="@color/fg_surface"
            app:cardCornerRadius="20dp"
            app:strokeColor="@color/fg_blue"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:contentDescription="@string/device_discovery"
                        android:src="@drawable/ic_network_scan" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="@string/device_discovery"
                        android:textAlignment="viewStart"
                        android:textColor="@color/fg_text"
                        android:textSize="19sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:hint="@string/ip_hint"
                    app:boxStrokeColor="@color/fg_blue"
                    app:hintTextColor="@color/fg_text_secondary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/ipInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionDone"
                        android:inputType="text"
                        android:singleLine="true"
                        android:textColor="@color/fg_text"
                        android:textDirection="ltr" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/scanButton"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:text="@string/scan"
                        android:textColor="@color/fg_text"
                        app:backgroundTint="@color/fg_blue"
                        app:cornerRadius="14dp"
                        app:icon="@drawable/ic_network_scan"
                        app:iconTint="@color/fg_text" />

                    <Space
                        android:layout_width="10dp"
                        android:layout_height="1dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/probeButton"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:text="@string/probe"
                        android:textColor="@color/fg_green"
                        app:cornerRadius="14dp"
                        app:icon="@drawable/ic_probe"
                        app:iconTint="@color/fg_green"
                        app:strokeColor="@color/fg_green" />
                </LinearLayout>

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progress"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="12dp"
                    android:visibility="invisible"
                    app:indicatorColor="@color/fg_green"
                    app:trackColor="@color/fg_surface_3" />

                <TextView
                    android:id="@+id/deviceState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/idle"
                    android:textAlignment="viewStart"
                    android:textColor="@color/fg_green"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/discoveryDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/scan_explanation"
                    android:textAlignment="viewStart"
                    android:textColor="@color/fg_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/outlets"
            android:textAlignment="viewStart"
            android:textColor="@color/fg_text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/outlets_subtitle"
            android:textAlignment="viewStart"
            android:textColor="@color/fg_text_secondary"
            android:textSize="12sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardBackgroundColor="@color/fg_surface"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/fg_blue"
            app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="68dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="14dp">
                <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_power_outlet" android:contentDescription="@string/outlet_1" app:tint="@color/fg_blue" />
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/outlet1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="10dp" android:layout_weight="1" android:enabled="false" android:text="@string/outlet_1" android:textColor="@color/fg_text" app:switchMinWidth="52dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" app:cardBackgroundColor="@color/fg_surface" app:cardCornerRadius="16dp" app:strokeColor="@color/fg_green_dark" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="68dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="14dp">
                <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_power_outlet" android:contentDescription="@string/outlet_2" app:tint="@color/fg_green" />
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/outlet2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="10dp" android:layout_weight="1" android:enabled="false" android:text="@string/outlet_2" android:textColor="@color/fg_text" app:switchMinWidth="52dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" app:cardBackgroundColor="@color/fg_surface" app:cardCornerRadius="16dp" app:strokeColor="@color/fg_silver_dark" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="68dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="14dp">
                <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_power_outlet" android:contentDescription="@string/outlet_3" app:tint="@color/fg_silver" />
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/outlet3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="10dp" android:layout_weight="1" android:enabled="false" android:text="@string/outlet_3" android:textColor="@color/fg_text" app:switchMinWidth="52dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" app:cardBackgroundColor="@color/fg_surface" app:cardCornerRadius="16dp" app:strokeColor="@color/fg_blue_bright" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="68dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="14dp">
                <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_power_outlet" android:contentDescription="@string/outlet_4" app:tint="@color/fg_blue_bright" />
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/outlet4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="10dp" android:layout_weight="1" android:enabled="false" android:text="@string/outlet_4" android:textColor="@color/fg_text" app:switchMinWidth="52dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/locked"
            android:textAlignment="viewStart"
            android:textColor="@color/fg_warning"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:text="@string/about_line"
            android:textColor="@color/fg_silver_dark"
            android:textSize="11sp" />

    </LinearLayout>
</ScrollView>
